<mujoco>
  <compiler meshdir="../assets" angle="radian"/>

  <default>
    <default class="cell_collision">
      <geom material="collision_material" condim="3" contype="1" conaffinity="1" priority="1" group="4" solref="0.005 1" friction="1 0.005 0.001" />
    </default>
    <default class="cell_visual">
      <geom contype="0" conaffinity="0" group="1" />
    </default>
    <default class="lifter">
      <joint limited="true" type="slide" damping="50" />
      <position forcelimited="true" forcerange="-3000 3000" ctrllimited="true" />
    </default>
  </default>

  <statistic center="1.3 0 0.6" extent="3.5" meansize="0.05"/>
  <option timestep="0.001" integrator="implicitfast" cone="elliptic" impratio="10" />

  <visual>
    <map znear="0.00614285714285714" /> <!-- Near clip: 21.5 mm -->
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="0" elevation="-20"/>
    <quality shadowsize="8192"/>
  </visual>

