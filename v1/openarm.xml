<mujoco model="openarm">

  <option timestep="0.001" integrator="implicitfast" />

  <default>
    <joint stiffness="0" ref="0.0" />
    <default class="robot">
      <!-- Armatures approximate motor rotor readouts * gear ratio squared (kg*m^2).
           Damping references from motor readouts, assuming the same conversion (N*m*s/rad):
           DM8009P ~0.13, DM4340 ~0.33, DM4310 ~0.03. Reference only; gearbox contributions
           are unconfirmed. Arm damping follows the V2 model. -->
      <default class="motor_DM8009">
        <joint frictionloss="0.1" damping="1.0" armature="0.016" limited="true" type="hinge" />
        <position forcelimited="true" forcerange="-40 40" ctrllimited="true" />
      </default>
      <default class="motor_DM4340">
        <joint frictionloss="0.1" damping="0.9" armature="0.030" limited="true" type="hinge" />
        <position forcelimited="true" forcerange="-27 27" ctrllimited="true" />
      </default>
      <default class="motor_DM4310">
        <joint frictionloss="0.1" damping="0.9" armature="0.002" limited="true" type="hinge" />
        <position forcelimited="true" forcerange="-7 7" ctrllimited="true" />
      </default>
      <default class="motor_finger">
        <!-- Approximate linkage-reflected inertia, split between two coupled fingers: 0.55 kg each. -->
        <joint type="slide" limited="true" damping="9" frictionloss="0" armature="0.55" />
        <position forcelimited="true" forcerange="-333 333" ctrllimited="true"
          ctrlrange="-0.005 0.044" />
      </default>
      <default class="collision">
        <geom material="collision_material" condim="3" conaffinity="1" priority="1" group="3"
          solref="0.005 1" friction="1 0.01 0.01" />
        <equality solimp="0.99 0.999 1e-05" solref="0.005 1" />
      </default>
      <default class="visual">
        <geom material="visualgeom" contype="0" conaffinity="0" group="2" />
      </default>
    </default>
  </default>

